    <!-- 文字与配色 -->
    <Border Classes="card">
      <StackPanel Spacing="12">
        <StackPanel Spacing="2">
          <TextBlock Classes="cardTitle" Text="文字与配色" />
          <TextBlock Classes="cardDesc" Text="歌词字号、字重，以及已播放/未播放的渐变配色。" />
        </StackPanel>
        
        <!-- 字号 / 字重 (保持不变) -->
        <Grid ColumnDefinitions="120,*" ColumnSpacing="14" Margin="0,4,0,0">
          <TextBlock Classes="sectionLabel" Text="字号 / 字重" VerticalAlignment="Center" />
          <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Grid ColumnDefinitions="*,64">
              <Slider Minimum="10" Maximum="120" TickFrequency="1"
                      Value="{Binding FontSize, Mode=TwoWay}" />
              <TextBox Grid.Column="1" MinHeight="28" Padding="8,2"
                       Text="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F0}'}"
                       TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
            </Grid>
            <ComboBox Grid.Column="1" ItemsSource="{Binding WeightOptions}"
                      SelectedIndex="{Binding WeightIndex, Mode=TwoWay}" />
          </Grid>
        </Grid>

        <Separator Margin="0,4" />

        <!-- ================= 已播放配色 ================= -->
        <!-- 1. 标题与色块在一行 -->
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Classes="cardTitle" FontSize="13" Text="已播放配色" VerticalAlignment="Center" />
          <Border Width="36" Height="20" CornerRadius="4" BorderBrush="#2BFFFFFF" BorderThickness="1" VerticalAlignment="Center">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="{Binding GradientTopColorValue}" Offset="0" />
                <GradientStop Color="{Binding GradientBottomColorValue}" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </StackPanel>

        <!-- 2. 取色器并排两列，自动均分 -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,4,0,0">
          <StackPanel Spacing="4">
            <TextBlock Classes="sectionLabel" Text="渐变上" />
            <local:ColorPicker Color="{Binding GradientTopColorValue, Mode=TwoWay}" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Classes="sectionLabel" Text="渐变下" />
            <local:ColorPicker Color="{Binding GradientBottomColorValue, Mode=TwoWay}" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Grid>

        <!-- ================= 未播放配色 ================= -->
        <!-- 1. 标题与色块在一行 -->
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,8,0,0">
          <TextBlock Classes="cardTitle" FontSize="13" Text="未播放配色" VerticalAlignment="Center" />
          <Border Width="36" Height="20" CornerRadius="4" BorderBrush="#2BFFFFFF" BorderThickness="1" VerticalAlignment="Center">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="{Binding InactiveGradientTopColorValue}" Offset="0" />
                <GradientStop Color="{Binding InactiveGradientBottomColorValue}" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </StackPanel>

        <!-- 2. 取色器并排两列，自动均分 -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,4,0,0">
          <StackPanel Spacing="4">
            <TextBlock Classes="sectionLabel" Text="渐变上" />
            <local:ColorPicker Color="{Binding InactiveGradientTopColorValue, Mode=TwoWay}" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Classes="sectionLabel" Text="渐变下" />
            <local:ColorPicker Color="{Binding InactiveGradientBottomColorValue, Mode=TwoWay}" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Grid>

        <!-- 未播放不透明度 -->
        <Grid ColumnDefinitions="120,*,64" ColumnSpacing="14" Margin="0,8,0,0">
          <TextBlock Classes="sectionLabel" Text="未播放不透明度" VerticalAlignment="Center" />
          <Slider Grid.Column="1" Minimum="0.05" Maximum="1" TickFrequency="0.05"
                  Value="{Binding InactiveOpacityVal, Mode=TwoWay}" />
          <TextBox Grid.Column="2" MinHeight="28" Padding="8,2"
                   Text="{Binding InactiveOpacityVal, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F2}'}"
                   TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
        </Grid>
        <TextBlock Text="未播放不透明度为相对比例：100% 时未播放与已播放等亮。" FontSize="11" Opacity="0.6" />

        <Separator Margin="0,4" />

        <!-- 翻译字号 -->
        <Grid ColumnDefinitions="120,*" ColumnSpacing="14">
          <TextBlock Classes="sectionLabel" Text="翻译字号" VerticalAlignment="Center" />
          <Grid Grid.Column="1" ColumnDefinitions="*,64" ColumnSpacing="14">
            <Slider Minimum="0" Maximum="80" TickFrequency="1"
                    Value="{Binding TransFontSizeVal, Mode=TwoWay}" />
            <TextBox Grid.Column="1" MinHeight="28" Padding="8,2"
                     Text="{Binding TransFontSizeVal, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F0}'}"
                     TextAlignment="Right" VerticalAlignment="Center" FontSize="12" />
          </Grid>
        </Grid>
        <TextBlock Text="翻译字号为 0 时自动取正文字号的 60%。" FontSize="11" Opacity="0.6" />

      </StackPanel>
    </Border>
