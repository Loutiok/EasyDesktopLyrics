<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EasyDesktopLyrics.Views.ColorPicker"
             MinWidth="260">

  <StackPanel Spacing="8">
    <!-- 饱和度/明度面板 -->
    <Border x:Name="SvPanel" Height="130" CornerRadius="6" ClipToBounds="True"
            Background="White" Cursor="Cross">
      <Border x:Name="SvShade" Background="Transparent" CornerRadius="6">
        <Canvas>
          <Border x:Name="SvIndicator" Width="12" Height="12" CornerRadius="6"
                  BorderBrush="White" BorderThickness="2" Background="Transparent"
                  Canvas.Left="0" Canvas.Top="0" />
        </Canvas>
      </Border>
    </Border>

    <!-- 色相条 -->
    <Border x:Name="HueBar" Height="14" CornerRadius="6" Cursor="Cross">
      <Canvas>
        <Border x:Name="HueIndicator" Width="6" Height="18" CornerRadius="2"
                BorderBrush="White" BorderThickness="1.5" Background="Transparent"
                Canvas.Left="0" Canvas.Top="-2" />
      </Canvas>
    </Border>

    <!-- 明暗（V）条 -->
    <Border x:Name="ValueBar" Height="14" CornerRadius="6" Cursor="Cross">
      <Canvas>
        <Border x:Name="ValueIndicator" Width="6" Height="18" CornerRadius="2"
                BorderBrush="White" BorderThickness="1.5" Background="Transparent"
                Canvas.Left="0" Canvas.Top="-2" />
      </Canvas>
    </Border>

    <!-- Hex 输入 + 预览 -->
    <Grid ColumnDefinitions="*,44" ColumnSpacing="8">
      <TextBox x:Name="HexBox" VerticalAlignment="Center" Height="28" Padding="8,0" VerticalContentAlignment="Center" />
      <Border x:Name="PreviewBlock" Grid.Column="1" Width="44" Height="28"
              CornerRadius="6" VerticalAlignment="Center" BorderBrush="#33FFFFFF" BorderThickness="1" />
    </Grid>

    <!-- RGB / HSL 切换面板 -->
    <TabControl Padding="0" Margin="0,4,0,0">
      <TabItem Header="RGB" FontSize="12" Padding="12,6">
        <Grid ColumnDefinitions="20,*,56" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" Margin="0,8,0,0" ColumnSpacing="8">
          <TextBlock Text="R" Foreground="#FF5555" FontWeight="Bold" VerticalAlignment="Center"/>
          <Slider Grid.Column="1" x:Name="RSlider" Minimum="0" Maximum="255" ValueChanged="OnRgbSliderChanged" />
          <TextBox Grid.Column="2" x:Name="RBox" Height="26" MinHeight="26" Padding="4,0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="12" TextChanged="OnRgbBoxChanged" />

          <TextBlock Text="G" Grid.Row="1" Foreground="#55FF55" FontWeight="Bold" VerticalAlignment="Center"/>
          <Slider Grid.Column="1" Grid.Row="1" x:Name="GSlider" Minimum="0" Maximum="255" ValueChanged="OnRgbSliderChanged" />
          <TextBox Grid.Column="2" Grid.Row="1" x:Name="GBox" Height="26" MinHeight="26" Padding="4,0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="12" TextChanged="OnRgbBoxChanged" />

          <TextBlock Text="B" Grid.Row="2" Foreground="#5555FF" FontWeight="Bold" VerticalAlignment="Center"/>
          <Slider Grid.Column="1" Grid.Row="2" x:Name="BSlider" Minimum="0" Maximum="255" ValueChanged="OnRgbSliderChanged" />
          <TextBox Grid.Column="2" Grid.Row="2" x:Name="BBox" Height="26" MinHeight="26" Padding="4,0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="12" TextChanged="OnRgbBoxChanged" />
        </Grid>
      </TabItem>

      <TabItem Header="HSL" FontSize="12" Padding="12,6">
        <Grid ColumnDefinitions="20,*,56" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" Margin="0,8,0,0" ColumnSpacing="8">
          <TextBlock Text="H" VerticalAlignment="Center" FontWeight="Bold"/>
          <Slider Grid.Column="1" x:Name="HSlider" Minimum="0" Maximum="360" ValueChanged="OnHslSliderChanged" />
          <TextBox Grid.Column="2" x:Name="HBox" Height="26" MinHeight="26" Padding="4,0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="12" TextChanged="OnHslBoxChanged" />

          <TextBlock Text="S" Grid.Row="1" VerticalAlignment="Center" FontWeight="Bold"/>
          <Slider Grid.Column="1" Grid.Row="1" x:Name="SSlider" Minimum="0" Maximum="100" ValueChanged="OnHslSliderChanged" />
          <TextBox Grid.Column="2" Grid.Row="1" x:Name="SBox" Height="26" MinHeight="26" Padding="4,0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="12" TextChanged="OnHslBoxChanged" />

          <TextBlock Text="L" Grid.Row="2" VerticalAlignment="Center" FontWeight="Bold"/>
          <Slider Grid.Column="1" Grid.Row="2" x:Name="LSlider" Minimum="0" Maximum="100" ValueChanged="OnHslSliderChanged" />
          <TextBox Grid.Column="2" Grid.Row="2" x:Name="LBox" Height="26" MinHeight="26" Padding="4,0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="12" TextChanged="OnHslBoxChanged" />
        </Grid>
      </TabItem>
    </TabControl>
  </StackPanel>

</UserControl>
