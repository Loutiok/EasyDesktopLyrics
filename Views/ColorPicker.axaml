<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:EasyDesktopLyrics.Views"
             x:Class="EasyDesktopLyrics.Views.ColorPicker"
             x:DataType="views:ColorPicker">
  
  <Button Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
    <Button.Content>
      <Border Width="48" Height="32" CornerRadius="4" BorderBrush="#2BFFFFFF" BorderThickness="1"
              Background="{Binding CurrentColorBrush}" />
    </Button.Content>
    
    <!-- 点击弹出的调色板面板 -->
    <Button.Flyout>
      <Flyout Placement="Bottom">
        <Border Padding="12" Background="#1E1E1E" CornerRadius="8">
          <StackPanel Spacing="10" Width="280">
            
            <!-- 💡 核心：Avalonia 官方自带的顶级色盘、色相条、透明度条 -->
            <ColorView Color="{Binding Color, Mode=TwoWay}" 
                       IsAlphaVisible="True" 
                       IsColorPaletteVisible="True" />

            <!-- 咱们自定义的 RGB / HSL 滑块输入区 -->
            <TabControl Padding="0" Margin="0,4,0,0">
              <!-- RGB -->
              <TabItem Header="RGB" FontSize="12" Padding="8,4">
                <Grid ColumnDefinitions="20,*,50" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" Margin="0,8,0,0">
                  <TextBlock Text="R" Foreground="#FF5555" FontWeight="Bold" VerticalAlignment="Center"/>
                  <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding R, Mode=TwoWay}" />
                  <TextBox Grid.Column="2" Text="{Binding R, Mode=TwoWay}" Height="26" MinHeight="26" Padding="4,2" TextAlignment="Right" FontSize="12"/>

                  <TextBlock Text="G" Grid.Row="1" Foreground="#55FF55" FontWeight="Bold" VerticalAlignment="Center"/>
                  <Slider Grid.Column="1" Grid.Row="1" Minimum="0" Maximum="255" Value="{Binding G, Mode=TwoWay}" />
                  <TextBox Grid.Column="2" Grid.Row="1" Text="{Binding G, Mode=TwoWay}" Height="26" MinHeight="26" Padding="4,2" TextAlignment="Right" FontSize="12"/>

                  <TextBlock Text="B" Grid.Row="2" Foreground="#5555FF" FontWeight="Bold" VerticalAlignment="Center"/>
                  <Slider Grid.Column="1" Grid.Row="2" Minimum="0" Maximum="255" Value="{Binding B, Mode=TwoWay}" />
                  <TextBox Grid.Column="2" Grid.Row="2" Text="{Binding B, Mode=TwoWay}" Height="26" MinHeight="26" Padding="4,2" TextAlignment="Right" FontSize="12"/>
                </Grid>
              </TabItem>

              <!-- HSL -->
              <TabItem Header="HSL" FontSize="12" Padding="8,4">
                <Grid ColumnDefinitions="20,*,50" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" Margin="0,8,0,0">
                  <TextBlock Text="H" VerticalAlignment="Center" FontWeight="Bold"/>
                  <Slider Grid.Column="1" Minimum="0" Maximum="360" Value="{Binding H, Mode=TwoWay}" />
                  <TextBox Grid.Column="2" Text="{Binding H, Mode=TwoWay}" Height="26" MinHeight="26" Padding="4,2" TextAlignment="Right" FontSize="12"/>

                  <TextBlock Text="S" Grid.Row="1" VerticalAlignment="Center" FontWeight="Bold"/>
                  <Slider Grid.Column="1" Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding S, Mode=TwoWay}" />
                  <TextBox Grid.Column="2" Grid.Row="1" Text="{Binding S, Mode=TwoWay}" Height="26" MinHeight="26" Padding="4,2" TextAlignment="Right" FontSize="12"/>

                  <TextBlock Text="L" Grid.Row="2" VerticalAlignment="Center" FontWeight="Bold"/>
                  <Slider Grid.Column="1" Grid.Row="2" Minimum="0" Maximum="100" Value="{Binding L, Mode=TwoWay}" />
                  <TextBox Grid.Column="2" Grid.Row="2" Text="{Binding L, Mode=TwoWay}" Height="26" MinHeight="26" Padding="4,2" TextAlignment="Right" FontSize="12"/>
                </Grid>
              </TabItem>
            </TabControl>

            <!-- 底部 Hex 输入框 -->
            <Grid ColumnDefinitions="*" Margin="0,4,0,0">
              <TextBox Text="{Binding HexText, Mode=TwoWay}" Height="32" Watermark="Hex 颜色代码"
                       LostFocus="OnHexLostFocus" KeyDown="OnHexKeyDown" />
            </Grid>
            
          </StackPanel>
        </Border>
      </Flyout>
    </Button.Flyout>
  </Button>
</UserControl>
