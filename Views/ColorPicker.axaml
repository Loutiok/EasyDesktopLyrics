<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EasyDesktopLyrics.Views.ColorPicker"
             MinWidth="135" Width="135">

  <StackPanel Spacing="4">
    <!-- 饱和度/明度面板 (紧凑) -->
    <Border x:Name="SvPanel" Height="85" CornerRadius="4" ClipToBounds="True"
            Background="White" Cursor="Cross">
      <Border x:Name="SvShade" Background="Transparent" CornerRadius="4">
        <Canvas>
          <Border x:Name="SvIndicator" Width="8" Height="8" CornerRadius="4"
                  BorderBrush="White" BorderThickness="1.5" Background="Transparent"
                  Canvas.Left="0" Canvas.Top="0" />
        </Canvas>
      </Border>
    </Border>

    <!-- 色相条 -->
    <Border x:Name="HueBar" Height="8" CornerRadius="3" Cursor="Cross">
      <Canvas>
        <Border x:Name="HueIndicator" Width="4" Height="12" CornerRadius="1"
                BorderBrush="White" BorderThickness="1" Background="Transparent"
                Canvas.Left="0" Canvas.Top="-2" />
      </Canvas>
    </Border>

    <!-- 明暗（V）条 -->
    <Border x:Name="ValueBar" Height="8" CornerRadius="3" Cursor="Cross">
      <Canvas>
        <Border x:Name="ValueIndicator" Width="4" Height="12" CornerRadius="1"
                BorderBrush="White" BorderThickness="1" Background="Transparent"
                Canvas.Left="0" Canvas.Top="-2" />
      </Canvas>
    </Border>

    <!-- Hex 输入 + 预览 -->
    <Grid ColumnDefinitions="*,28" ColumnSpacing="4" Margin="0,2,0,0">
      <TextBox x:Name="HexBox" VerticalAlignment="Center" Height="24" MinHeight="24" Padding="4,0" FontSize="12" VerticalContentAlignment="Center" />
      <Border x:Name="PreviewBlock" Grid.Column="1" Width="28" Height="24"
              CornerRadius="4" VerticalAlignment="Center" BorderBrush="#33FFFFFF" BorderThickness="1" />
    </Grid>

    <!-- 纯输入框的切换页 -->
    <TabControl Padding="0" Margin="0,2,0,0">
      <TabItem Header="RGB" FontSize="10" Padding="4,2">
        <!-- 横排三个输入框 -->
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4" Margin="0,4,0,0">
          <TextBox x:Name="RBox" Height="24" MinHeight="24" Padding="0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="12" TextChanged="OnRgbBoxChanged" LostFocus="OnBoxLostFocus" KeyDown="OnBoxKeyDown" />
          <TextBox x:Name="GBox" Grid.Column="1" Height="24" MinHeight="24" Padding="0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="12" TextChanged="OnRgbBoxChanged" LostFocus="OnBoxLostFocus" KeyDown="OnBoxKeyDown" />
          <TextBox x:Name="BBox" Grid.Column="2" Height="24" MinHeight="24" Padding="0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="12" TextChanged="OnRgbBoxChanged" LostFocus="OnBoxLostFocus" KeyDown="OnBoxKeyDown" />
        </Grid>
      </TabItem>

      <TabItem Header="HSL" FontSize="10" Padding="4,2">
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4" Margin="0,4,0,0">
          <TextBox x:Name="HBox" Height="24" MinHeight="24" Padding="0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="12" TextChanged="OnHslBoxChanged" LostFocus="OnBoxLostFocus" KeyDown="OnBoxKeyDown" />
          <TextBox x:Name="SBox" Grid.Column="1" Height="24" MinHeight="24" Padding="0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="12" TextChanged="OnHslBoxChanged" LostFocus="OnBoxLostFocus" KeyDown="OnBoxKeyDown" />
          <TextBox x:Name="LBox" Grid.Column="2" Height="24" MinHeight="24" Padding="0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="12" TextChanged="OnHslBoxChanged" LostFocus="OnBoxLostFocus" KeyDown="OnBoxKeyDown" />
        </Grid>
      </TabItem>
    </TabControl>
  </StackPanel>

</UserControl>
