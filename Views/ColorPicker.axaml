<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:EasyDesktopLyrics.Views"
             x:Class="EasyDesktopLyrics.Views.ColorPicker"
             x:DataType="views:ColorPicker"
             MinWidth="240">
  <StackPanel Spacing="8">
    <!-- 顶部：预览色块 + Hex 输入 -->
    <Grid ColumnDefinitions="60,*" ColumnSpacing="10">
      <Border Background="{Binding CurrentColorBrush}" CornerRadius="4" BorderBrush="#2BFFFFFF" BorderThickness="1" Height="32" />
      <!-- 修复警告：Watermark 改为 PlaceholderText -->
      <TextBox Grid.Column="1" Text="{Binding HexText, Mode=TwoWay}" VerticalAlignment="Center" Height="32" PlaceholderText="#FFFFFFFF"/>
    </Grid>

    <TabControl Padding="0" Margin="0,4,0,0">
      <!-- RGB 面板 -->
      <TabItem Header="RGB" FontSize="12" Padding="12,6">
        <StackPanel Spacing="8" Margin="0,8,0,0">
          <Grid ColumnDefinitions="20,*,50" ColumnSpacing="10">
            <TextBlock Text="R" VerticalAlignment="Center" Foreground="#FF5555" FontWeight="Bold"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding R, Mode=TwoWay}" />
            <TextBox Grid.Column="2" Text="{Binding R, Mode=TwoWay}" Height="26" MinHeight="26" Padding="4,2" TextAlignment="Right" FontSize="12"/>
          </Grid>
          <Grid ColumnDefinitions="20,*,50" ColumnSpacing="10">
            <TextBlock Text="G" VerticalAlignment="Center" Foreground="#55FF55" FontWeight="Bold"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding G, Mode=TwoWay}" />
            <TextBox Grid.Column="2" Text="{Binding G, Mode=TwoWay}" Height="26" MinHeight="26" Padding="4,2" TextAlignment="Right" FontSize="12"/>
          </Grid>
          <Grid ColumnDefinitions="20,*,50" ColumnSpacing="10">
            <TextBlock Text="B" VerticalAlignment="Center" Foreground="#5555FF" FontWeight="Bold"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding B, Mode=TwoWay}" />
            <TextBox Grid.Column="2" Text="{Binding B, Mode=TwoWay}" Height="26" MinHeight="26" Padding="4,2" TextAlignment="Right" FontSize="12"/>
          </Grid>
        </StackPanel>
      </TabItem>

      <!-- HSL 面板 -->
      <TabItem Header="HSL" FontSize="12" Padding="12,6">
        <StackPanel Spacing="8" Margin="0,8,0,0">
          <Grid ColumnDefinitions="20,*,50" ColumnSpacing="10">
            <TextBlock Text="H" VerticalAlignment="Center" ToolTip.Tip="色调 0-360" FontWeight="Bold"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="360" Value="{Binding H, Mode=TwoWay}" />
            <TextBox Grid.Column="2" Text="{Binding H, Mode=TwoWay}" Height="26" MinHeight="26" Padding="4,2" TextAlignment="Right" FontSize="12"/>
          </Grid>
          <Grid ColumnDefinitions="20,*,50" ColumnSpacing="10">
            <TextBlock Text="S" VerticalAlignment="Center" ToolTip.Tip="饱和度 0-100%" FontWeight="Bold"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding S, Mode=TwoWay}" />
            <TextBox Grid.Column="2" Text="{Binding S, Mode=TwoWay}" Height="26" MinHeight="26" Padding="4,2" TextAlignment="Right" FontSize="12"/>
          </Grid>
          <Grid ColumnDefinitions="20,*,50" ColumnSpacing="10">
            <TextBlock Text="L" VerticalAlignment="Center" ToolTip.Tip="亮度 0-100%" FontWeight="Bold"/>
            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding L, Mode=TwoWay}" />
            <TextBox Grid.Column="2" Text="{Binding L, Mode=TwoWay}" Height="26" MinHeight="26" Padding="4,2" TextAlignment="Right" FontSize="12"/>
          </Grid>
        </StackPanel>
      </TabItem>
    </TabControl>
  </StackPanel>
</UserControl>
