        <!-- 已播放配色 -->
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,8,0,0">
          <TextBlock Classes="cardTitle" FontSize="13" Text="已播放配色" VerticalAlignment="Center" />
          <!-- 预览色块移到标题右侧，尺寸稍微缩小 -->
          <Border Width="36" Height="20" CornerRadius="4" BorderBrush="#2BFFFFFF" BorderThickness="1" VerticalAlignment="Center">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="{Binding GradientTopColorValue}" Offset="0" />
                <GradientStop Color="{Binding GradientBottomColorValue}" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </StackPanel>
        
        <!-- 取色器并排两列，自动均分宽度 -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="20" Margin="0,4,0,0">
          <StackPanel Spacing="4">
            <TextBlock Classes="sectionLabel" Text="渐变上" />
            <local:ColorPicker Color="{Binding GradientTopColorValue, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Classes="sectionLabel" Text="渐变下" />
            <local:ColorPicker Color="{Binding GradientBottomColorValue, Mode=TwoWay}" />
          </StackPanel>
        </Grid>

        <Separator Margin="0,8" />

        <!-- 未播放配色 -->
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Classes="cardTitle" FontSize="13" Text="未播放配色" VerticalAlignment="Center" />
          <!-- 预览色块移到标题右侧 -->
          <Border Width="36" Height="20" CornerRadius="4" BorderBrush="#2BFFFFFF" BorderThickness="1" VerticalAlignment="Center">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="{Binding InactiveGradientTopColorValue}" Offset="0" />
                <GradientStop Color="{Binding InactiveGradientBottomColorValue}" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </StackPanel>
        
        <!-- 取色器并排两列 -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="20" Margin="0,4,0,0">
          <StackPanel Spacing="4">
            <TextBlock Classes="sectionLabel" Text="渐变上" />
            <local:ColorPicker Color="{Binding InactiveGradientTopColorValue, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Classes="sectionLabel" Text="渐变下" />
            <local:ColorPicker Color="{Binding InactiveGradientBottomColorValue, Mode=TwoWay}" />
          </StackPanel>
        </Grid>
