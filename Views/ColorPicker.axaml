    <!-- 纯输入框的 RGB / HSV 切换页 -->
    <TabControl Padding="0" Margin="0,4,0,0">
      <TabItem Header="RGB" FontSize="12" Padding="8,4">
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4" Margin="0,4,0,0">
          <TextBox x:Name="RBox" Height="28" MinHeight="28" Padding="0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="13" TextChanged="OnRgbBoxChanged" LostFocus="OnBoxLostFocus" KeyDown="OnBoxKeyDown" />
          <TextBox x:Name="GBox" Grid.Column="1" Height="28" MinHeight="28" Padding="0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="13" TextChanged="OnRgbBoxChanged" LostFocus="OnBoxLostFocus" KeyDown="OnBoxKeyDown" />
          <TextBox x:Name="BBox" Grid.Column="2" Height="28" MinHeight="28" Padding="0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="13" TextChanged="OnRgbBoxChanged" LostFocus="OnBoxLostFocus" KeyDown="OnBoxKeyDown" />
        </Grid>
      </TabItem>

      <TabItem Header="HSV" FontSize="12" Padding="8,4">
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4" Margin="0,4,0,0">
          <TextBox x:Name="HBox" Height="28" MinHeight="28" Padding="0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="13" TextChanged="OnHsvBoxChanged" LostFocus="OnBoxLostFocus" KeyDown="OnBoxKeyDown" ToolTip.Tip="色调 (0-360)" />
          <TextBox x:Name="SBox" Grid.Column="1" Height="28" MinHeight="28" Padding="0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="13" TextChanged="OnHsvBoxChanged" LostFocus="OnBoxLostFocus" KeyDown="OnBoxKeyDown" ToolTip.Tip="饱和度 (0-100)" />
          <TextBox x:Name="VBox" Grid.Column="2" Height="28" MinHeight="28" Padding="0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="13" TextChanged="OnHsvBoxChanged" LostFocus="OnBoxLostFocus" KeyDown="OnBoxKeyDown" ToolTip.Tip="亮度 (0-100)" />
        </Grid>
      </TabItem>
    </TabControl>
