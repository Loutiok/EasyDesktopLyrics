<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EasyDesktopLyrics.Views.ColorPicker">

  <StackPanel Spacing="6">
    <!-- 饱和度/明度面板 -->
    <Border x:Name="SvPanel" Height="120" CornerRadius="6" ClipToBounds="True"
            Background="White" Cursor="Cross">
      <Border x:Name="SvShade" Background="Transparent" CornerRadius="6">
        <Canvas>
          <Border x:Name="SvIndicator" Width="12" Height="12" CornerRadius="6"
                  BorderBrush="White" BorderThickness="2" Background="Transparent"
                  Canvas.Left="0" Canvas.Top="0" />
        </Canvas>
      </Border>
    </Border>

    <!-- 色相条 -->
    <Border x:Name="HueBar" Height="14" CornerRadius="6" Cursor="Cross">
      <Canvas>
        <Border x:Name="HueIndicator" Width="6" Height="18" CornerRadius="2"
                BorderBrush="White" BorderThickness="1.5" Background="Transparent"
                Canvas.Left="0" Canvas.Top="-2" />
      </Canvas>
    </Border>

    <!-- 明暗（V）条 -->
    <Border x:Name="ValueBar" Height="14" CornerRadius="6" Cursor="Cross">
      <Canvas>
        <Border x:Name="ValueIndicator" Width="6" Height="18" CornerRadius="2"
                BorderBrush="White" BorderThickness="1.5" Background="Transparent"
                Canvas.Left="0" Canvas.Top="-2" />
      </Canvas>
    </Border>

    <!-- Hex 输入 + 预览 -->
    <Grid ColumnDefinitions="*,44" ColumnSpacing="6" Margin="0,2,0,0">
      <TextBox x:Name="HexBox" Height="28" MinHeight="28" Padding="6,0" VerticalContentAlignment="Center" FontSize="13" />
      <Border x:Name="PreviewBlock" Grid.Column="1" Width="44" Height="28"
              CornerRadius="6" VerticalAlignment="Center" BorderBrush="#33FFFFFF" BorderThickness="1" />
    </Grid>

    <!-- 纯输入框的 RGB / HSL 切换页 -->
    <TabControl Padding="0" Margin="0,4,0,0">
      <TabItem Header="RGB" FontSize="12" Padding="8,4">
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4" Margin="0,4,0,0">
          <TextBox x:Name="RBox" Height="28" MinHeight="28" Padding="0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="13" TextChanged="OnRgbBoxChanged" LostFocus="OnBoxLostFocus" KeyDown="OnBoxKeyDown" />
          <TextBox x:Name="GBox" Grid.Column="1" Height="28" MinHeight="28" Padding="0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="13" TextChanged="OnRgbBoxChanged" LostFocus="OnBoxLostFocus" KeyDown="OnBoxKeyDown" />
          <TextBox x:Name="BBox" Grid.Column="2" Height="28" MinHeight="28" Padding="0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="13" TextChanged="OnRgbBoxChanged" LostFocus="OnBoxLostFocus" KeyDown="OnBoxKeyDown" />
        </Grid>
      </TabItem>

      <TabItem Header="HSL" FontSize="12" Padding="8,4">
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4" Margin="0,4,0,0">
          <TextBox x:Name="HBox" Height="28" MinHeight="28" Padding="0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="13" TextChanged="OnHslBoxChanged" LostFocus="OnBoxLostFocus" KeyDown="OnBoxKeyDown" />
          <TextBox x:Name="SBox" Grid.Column="1" Height="28" MinHeight="28" Padding="0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="13" TextChanged="OnHslBoxChanged" LostFocus="OnBoxLostFocus" KeyDown="OnBoxKeyDown" />
          <TextBox x:Name="LBox" Grid.Column="2" Height="28" MinHeight="28" Padding="0" VerticalContentAlignment="Center" TextAlignment="Center" FontSize="13" TextChanged="OnHslBoxChanged" LostFocus="OnBoxLostFocus" KeyDown="OnBoxKeyDown" />
        </Grid>
      </TabItem>
    </TabControl>
  </StackPanel>

</UserControl>
